.program flux_read

.wrap_target
wait_high:
    jmp x-- wait_high_next
wait_high_next:
    jmp pin wait_low_entry
    jmp wait_high
wait_low_entry:
    nop
wait_low:
    jmp x-- wait_low_next
wait_low_next:
    jmp pin wait_low [1]
    in pins, 1
    in x, 15
    jmp x-- wait_high
.wrap

% c-sdk {
#include "hardware/clocks.h"
#include "mfm.h"

static inline int flux_read_program_init(PIO pio, uint sm, uint offset, uint pin, uint index_pin) {
    pio_sm_config c = flux_read_program_get_default_config(offset);
    sm_config_set_jmp_pin(&c, pin);
    sm_config_set_in_pins(&c, index_pin);
    sm_config_set_in_shift(&c, true, true, 32);
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_RX);
    uint32_t sys_hz = clock_get_hz(clk_sys);
    uint16_t div_int = (uint16_t)(sys_hz / MFM_READ_PIO_HZ);
    uint8_t div_frac = (uint8_t)((uint64_t)(sys_hz % MFM_READ_PIO_HZ) * 256u / MFM_READ_PIO_HZ);
    sm_config_set_clkdiv_int_frac(&c, div_int, div_frac);
    pio_gpio_init(pio, pin);
    pio_gpio_init(pio, index_pin);
    int status = pio_sm_init(pio, sm, offset, &c);
    if (status != 0) return status;
    pio_sm_exec(pio, sm, pio_encode_set(pio_x, 0));
    pio_sm_exec(pio, sm, pio_encode_jmp(offset));
    return 0;
}

%}
