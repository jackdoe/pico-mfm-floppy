.program flux_write

.wrap_target
    pull block
    out x, 8
    set pins, 0
    nop [13]
    set pins, 1
wait_loop:
    jmp x-- wait_loop
.wrap

% c-sdk {
#include "hardware/clocks.h"
#include "mfm.h"

static inline int flux_write_program_init(PIO pio, uint sm, uint offset, uint pin) {
    pio_sm_config c = flux_write_program_get_default_config(offset);
    sm_config_set_set_pins(&c, pin, 1);
    sm_config_set_out_shift(&c, true, false, 32);
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_TX);
    uint32_t sys_hz = clock_get_hz(clk_sys);
    uint16_t div_int = (uint16_t)(sys_hz / MFM_WRITE_PIO_HZ);
    uint8_t div_frac = (uint8_t)((uint64_t)(sys_hz % MFM_WRITE_PIO_HZ) * 256u / MFM_WRITE_PIO_HZ);
    sm_config_set_clkdiv_int_frac(&c, div_int, div_frac);
    pio_gpio_init(pio, pin);
    pio_sm_set_consecutive_pindirs(pio, sm, pin, 1, true);
    pio_sm_set_pins_with_mask(pio, sm, 1u << pin, 1u << pin);
    return pio_sm_init(pio, sm, offset, &c);
}

%}
